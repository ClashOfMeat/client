{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clash of Meat",
  "version": "0.1.0",
  "identifier": "com.clashofmeat.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/clashofmeat"
    ],
    "createUpdaterArtifacts": false,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1OUQwRTQ4NzAyOUU4NEYKUldSUDZDbHdTQTZkNWNaWkpteVR6eXFhbVpHMFNYUS9ZNVNsSjVDTkVWbXYxNmxyS3FRZmNHMFAK"
    }
  }
}
